# Config for production builds (`next build`) — used by CI and by any local
# `npm run build`. `npm run dev` still uses .env.local (emulators).
#
# These NEXT_PUBLIC_* values are NOT secret: they are compiled into the
# client bundle and served on the public site regardless. Same values as
# letscng-ui's environment.prod.ts. API-key abuse is guarded by Firebase
# security rules + API key restrictions, not by hiding the key.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBd9AIpEXU-jfkp40JlCi0N34QiqHS7wW0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=challenge1177.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=challenge1177
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=challenge1177.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:59705937323:web:73d7ba7d7776d4f58a16ee

# Server-side (Admin SDK). No key here — the runtime authenticates via the
# Cloud Run service account, and CI authenticates via GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=challenge1177

# Strava OAuth client id — not secret (same value already ships inside
# letscng-ui's client bundle). The matching CLIENT_SECRET is deliberately
# NOT here; it's injected at runtime from an App Hosting secret (see
# apphosting.yaml).
STRAVA_CLIENT_ID=69720
