# Copy to .env.local and fill in for local dev.
# For local emulator dev, the NEXT_PUBLIC_FIREBASE_* values can stay as
# placeholders — the emulators don't validate them.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=challenge1177.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=challenge1177
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=challenge1177.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Server-side (Admin SDK). Not needed when talking to emulators only —
# admin.ts auto-detects FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# (set below) and skips real credentials in that case.
FIREBASE_PROJECT_ID=challenge1177
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Point the Admin SDK at the local emulators (set by `firebase emulators:start`
# too, but Next.js needs them in its own env when run separately via `next dev`).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Strava OAuth (see src/lib/strava.ts). CLIENT_ID isn't secret (same value
# ships in the legacy Angular app's client bundle already) — CLIENT_SECRET
# is: never put a real value in this file or .env.production. In deployed
# environments it comes from an App Hosting secret instead (see
# apphosting.yaml / docs/DEPLOY.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Razorpay (registration payment sync — see src/lib/razorpay.ts and
# src/app/api/webhooks/razorpay/route.ts). Never put real values in this
# file or .env.production. In deployed environments both come from App
# Hosting secrets instead (see apphosting.yaml / docs/DEPLOY.md).
# KEY_ID/KEY_SECRET aren't used yet (stage 1 only verifies + logs the raw
# webhook event) but are here ready for the Orders/Payments API lookup
# stage 2 needs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Sheets (registration sync — see src/lib/googleSheets.ts and
# src/lib/legacy-registrations.ts). The full service-account key JSON as a
# single line — same account (cng-google-sheet@challenge1177.iam.gserviceaccount.com)
# the legacy backend already uses, already granted access to the shared
# registrations spreadsheet. Never put a real value in this file or
# .env.production; in deployed environments it comes from an App Hosting
# secret instead (see apphosting.yaml / docs/DEPLOY.md).
GOOGLE_SHEETS_CREDENTIALS_JSON=
