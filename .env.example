# Copy to .env.local and fill in for local dev.
# For local emulator dev, the NEXT_PUBLIC_FIREBASE_* values can stay as
# placeholders — the emulators don't validate them.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=challenge1177.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=challenge1177
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=challenge1177.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Server-side (Admin SDK). Not needed when talking to emulators only —
# admin.ts auto-detects FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# (set below) and skips real credentials in that case.
FIREBASE_PROJECT_ID=challenge1177
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Point the Admin SDK at the local emulators (set by `firebase emulators:start`
# too, but Next.js needs them in its own env when run separately via `next dev`).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
