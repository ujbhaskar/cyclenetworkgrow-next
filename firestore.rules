rules_version = '2';

// See docs/ARCHITECTURE.md §9 for the data model and the access-control
// principle this file encodes: riders can read public collections and their
// own docs; almost all writes go through the Admin SDK (Route
// Handlers/Server Actions/Cloud Functions) only, never direct client writes.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Never readable/writable from the client — Admin SDK only.
    match /stravaTokens/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // "events" (not "cyclingEvents") is the LEGACY collection used by the
    // live production Angular/Express app — this app never reads/writes it.
    // Left as-is intentionally; do not repurpose this rule block.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The new app's own events collection — public read, admin-only write.
    match /cyclingEvents/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboards/{eventId}/{document=**} {
      allow read: if true;
      allow write: if false; // Cloud Functions (Admin SDK) only.
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /eventParticipants/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // exclusion/flag edits go through admin tools
    }

    match /offlineResults/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instagramPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A rider may create their own testimonial (status forced server-side),
    // but never set its own status to approved.
    match /testimonials/{testimonialId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /enduranceRiders/{riderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enduranceRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only.
    }

    match /platformSettings/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only (drives real Strava subscribe/unsubscribe).
    }

    match /siteSettings/{docId} {
      allow read: if true; // Public site config (e.g. home hero/ready-to-ride banners) — not sensitive.
      allow write: if false; // Admin SDK only, via /api/admin/hero-banner and /api/admin/ready-to-ride-banner.
    }
  }
}
